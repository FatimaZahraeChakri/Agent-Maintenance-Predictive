# ==============================================================================
# Modèle de configuration (.env.example)
# Copier ce fichier vers ".env" plus tard et renseigner les vraies valeurs en local.
# Ne jamais commiter le fichier ".env" sur GitHub.
# ==============================================================================

# Base de données PostgreSQL (Phase 6)
DATABASE_URL=postgresql://utilisateur:mot_de_passe@localhost:5432/maintenance_predictive

# Clé API du modèle de langage LLM utilisé par l'agent (Phase 5)
LLM_API_KEY=votre_cle_api_ici

# Configuration du serveur FastAPI (Phase 6)
API_HOST=127.0.0.1
API_PORT=8000

